# ローカル開発専用のサンプル値です。本番用の秘密情報を記載しないでください。
MYSQL_DATABASE=dabuchi
MYSQL_USER=dabuchi_app
MYSQL_PASSWORD=replace-with-local-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_PORT=3306
MYSQL_HOST=127.0.0.1
NODE_ENV=development

# 開発サーバーを待ち受けるアドレス。未設定ならこのマシンからのみ開ける。
# スマートフォンなど別端末で確認するときだけ、その端末から届くアドレスを指定する。
# 例: TailscaleのIP（tailscale ip -4 で確認）
# DEV_BIND_ADDRESS=100.x.y.z

# Viteが受け付けるホスト名（カンマ区切り）。公開URLで開くときに指定する。
# 例: Tailscale Funnel（tailscale status で自分のMagicDNS名を確認）
# DEV_ALLOWED_HOSTS=macbook-air.tailXXXXX.ts.net
